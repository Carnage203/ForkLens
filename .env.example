# Copy to .env (local) and add the same names in Vercel > Project > Settings > Environment Variables.
# .env is gitignored. NEVER commit real values.

# ---- AI providers (free tiers). Leave all empty to run in demo (mock) mode. ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
VISION_MODEL=gemini-4-hydrogen
GEN_MODEL=gemini-3.6-flash
FALLBACK_MODELS=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ---- Database: Supabase Postgres, "Transaction pooler" connection string (port 6543). Empty = local SQLite file. ----
DATABASE_URL=

# ---- Supabase Auth (optional; without these the app runs in guest mode) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Admin console (hidden). All three needed or the console does not exist. ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=          # random, 32+ chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Secret URL of the console, built into the frontend at build time. Pick something unguessable.
VITE_ADMIN_PATH=/console-change-me

# ---- Cron + corpus ----
CRON_SECRET=               # Vercel sends it as a Bearer token to /api/cron/cleanup
CORPUS_SOURCE=local        # local (fast cold start) | cloud (Hugging Face with local fallback)
HF_DATASET_REPO=
HF_TOKEN=                  # only for scripts/upload_dataset.py, never deployed

# ---- Limits (optional) ----
GUEST_GEN_LIMIT=6
USER_GEN_LIMIT=20
ALLOWED_ORIGINS=http://localhost:5173
